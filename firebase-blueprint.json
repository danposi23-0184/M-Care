{
  "entities": {
    "patients": {
      "title": "Patient Profiles",
      "description": "Patient user profile and demographics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientCode": { "type": "string" },
        "fullName": { "type": "string" },
        "contactNumber": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "registeredDate": { "type": "string" },
        "isExistingRecordMatched": { "type": "boolean" }
      },
      "required": ["id", "fullName", "email"]
    },
    "appointments": {
      "title": "Appointments",
      "description": "Clinic appointments for consultations and ultrasound scans",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appointmentCode": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "appointmentType": { "type": "string" },
        "scanType": { "type": "string" },
        "status": { "type": "string" },
        "attendingDoctor": { "type": "string" }
      },
      "required": ["id", "patientId", "date", "timeSlot", "status"]
    },
    "medicalRecords": {
      "title": "Medical Records",
      "description": "Official ultrasound sonogram reports, patient diagnostic records, and clinical findings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientCode": { "type": "string" },
        "patientName": { "type": "string" },
        "recordType": { "type": "string" },
        "date": { "type": "string" },
        "doctorName": { "type": "string" },
        "findings": { "type": "string" },
        "gestationalAgeWeeks": { "type": "number" },
        "fetalHeartRateBpm": { "type": "number" },
        "bloodPressure": { "type": "string" },
        "weightKg": { "type": "number" },
        "prescriptions": { "type": "string" }
      },
      "required": ["id", "patientId", "recordType", "date", "findings"]
    },
    "notifications": {
      "title": "Notifications",
      "description": "In-app and push notification log for patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "patientId", "title", "message"]
    }
  }
}
